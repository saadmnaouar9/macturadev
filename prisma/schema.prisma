// Mactura — schéma de données
// Conventions :
//  - Montants en centimes (BigInt) pour éviter toute erreur d'arrondi flottant.
//  - Quantités en millièmes (Int) : 1,5 unité = 1500.
//  - Taux (TVA, remises) en points de base (Int) : 20 % = 2000.
//  - Toute donnée métier est rattachée à une entreprise (companyId) pour l'isolation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

// Cycle de vie du document (événements distincts : émission ≠ envoi ≠ paiement)
enum InvoiceStatus {
  DRAFT // brouillon, non numéroté
  ISSUED // émise : numéro définitif attribué
  SENT // envoyée au client
  CANCELLED // annulée (le numéro reste attribué)
}

// Situation de règlement — toujours dérivée de la somme des paiements actifs
enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CARD
  LCN
  OTHER
}

enum DiscountType {
  PERCENT
  AMOUNT
}

enum DocumentKind {
  INVOICE
  QUOTE
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  memberships  Membership[]
  sessions     Session[]
  activities   Activity[]
  tasks        Task[]       @relation("TaskAssignee")
}

model Company {
  id                 String     @id @default(cuid())
  name               String
  nameAr             String?
  legalForm          String?
  ice                String?
  taxId              String? // Identifiant Fiscal (IF)
  rc                 String? // Registre de Commerce
  rcCity             String?
  patente            String?
  cnss               String?
  capital            String?
  address            String?
  city               String?
  postalCode         String?
  country            String     @default("Maroc")
  phone              String?
  email              String?
  website            String?
  bankName           String?
  rib                String?
  currency           String     @default("MAD")
  invoicePrefix      String     @default("FAC")
  quotePrefix        String     @default("DEV")
  defaultPaymentDays Int        @default(30)
  quoteValidityDays  Int        @default(30)
  defaultTaxRate     Int        @default(2000)
  invoiceNotes       String?
  invoiceTerms       String?
  quoteNotes         String?
  quoteTerms         String?
  accentColor        String     @default("#3A3182")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  memberships        Membership[]
  customers          Customer[]
  products           Product[]
  categories         Category[]
  taxRates           TaxRate[]
  quotes             Quote[]
  invoices           Invoice[]
  payments           Payment[]
  activities         Activity[]
  counters           Counter[]
  sessions           Session[]
  openingCash        BigInt     @default(0) // solde d'ouverture de la caisse (centimes)
  openingBank        BigInt     @default(0) // solde d'ouverture du compte bancaire
  prospects          Prospect[]
  suppliers          Supplier[]
  purchases          Purchase[]
  purchasePayments   PurchasePayment[]
  cashEntries        CashEntry[]
  projects           Project[]
  tasks              Task[]
  contracts          Contract[]
  employees          Employee[]
}

model Membership {
  id                   String    @id @default(cuid())
  userId               String
  companyId            String
  role                 Role      @default(MEMBER)
  notificationsSeenAt  DateTime  @default(now())
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company              Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([companyId])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  companyId  String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  userAgent  String?
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Counter {
  id        String       @id @default(cuid())
  companyId String
  kind      DocumentKind
  year      Int
  value     Int          @default(0)
  company   Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, kind, year])
}

model TaxRate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  rate      Int // points de base
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, rate])
}

model Category {
  id        String    @id @default(cuid())
  companyId String
  name      String
  color     String    @default("#6366F1")
  createdAt DateTime  @default(now())
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([companyId, name])
}

model Customer {
  id          String       @id @default(cuid())
  companyId   String
  type        CustomerType @default(COMPANY)
  name        String // nom affiché (raison sociale ou nom complet)
  nameAr      String?
  contactName String?
  email       String?
  phone       String?
  mobile      String?
  ice         String?
  taxId       String?
  rc          String?
  address     String?
  city        String?
  postalCode  String?
  country     String       @default("Maroc")
  paymentDays Int?
  notes       String?
  archived    Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quotes      Quote[]
  invoices    Invoice[]
  contracts   Contract[]
  projects    Project[]
  tasks       Task[]

  @@index([companyId, name])
}

model Product {
  id          String        @id @default(cuid())
  companyId   String
  type        ProductType   @default(PRODUCT)
  name        String
  description String?
  sku         String?
  unit        String        @default("unité")
  unitPrice   BigInt // HT, en centimes
  taxRate     Int           @default(2000)
  categoryId  String?
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category    Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  quoteItems  QuoteItem[]
  invoiceItems InvoiceItem[]

  @@index([companyId, name])
}

model Quote {
  id               String      @id @default(cuid())
  companyId        String
  customerId       String
  number           String
  status           QuoteStatus @default(DRAFT)
  issueDate        DateTime
  expiryDate       DateTime
  reference        String?
  globalDiscountType   DiscountType @default(PERCENT)
  globalDiscount       Int          @default(0) // points de base (si PERCENT)
  globalDiscountAmount BigInt       @default(0) // centimes (si AMOUNT)
  subtotal         BigInt      @default(0) // HT brut
  discountTotal    BigInt      @default(0)
  taxableTotal     BigInt      @default(0) // HT net
  taxTotal         BigInt      @default(0)
  total            BigInt      @default(0) // TTC
  notes            String?
  terms            String?
  sentAt           DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer         Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items            QuoteItem[]
  invoice          Invoice?

  @@unique([companyId, number])
  @@index([companyId, status])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  productId   String?
  position    Int
  description String
  details     String?
  quantity    Int // millièmes
  unit        String   @default("unité")
  unitPrice   BigInt
  discountType   DiscountType @default(PERCENT)
  discount       Int          @default(0) // points de base (si PERCENT)
  discountAmount BigInt       @default(0) // centimes (si AMOUNT)
  taxRate        Int          @default(2000)
  netAmount   BigInt   @default(0) // HT après remise ligne
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([quoteId])
}

model Invoice {
  id             String        @id @default(cuid())
  companyId      String
  customerId     String
  quoteId        String?       @unique
  number         String? // attribué à l'émission pour garantir une numérotation continue
  status         InvoiceStatus @default(DRAFT)
  paymentStatus  PaymentStatus @default(UNPAID)
  issueDate      DateTime
  dueDate        DateTime
  paymentTerms   String?
  reference      String?
  globalDiscountType   DiscountType  @default(PERCENT)
  globalDiscount       Int           @default(0)
  globalDiscountAmount BigInt        @default(0)
  subtotal       BigInt        @default(0)
  discountTotal  BigInt        @default(0)
  taxableTotal   BigInt        @default(0)
  taxTotal       BigInt        @default(0)
  total          BigInt        @default(0)
  amountPaid     BigInt        @default(0)
  notes          String?
  terms          String?
  issuedAt       DateTime?
  sentAt         DateTime?
  paidAt         DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  quote          Quote?        @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  items          InvoiceItem[]
  payments       Payment[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([companyId, paymentStatus])
  @@index([companyId, dueDate])
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  position    Int
  description String
  details     String?
  quantity    Int
  unit        String   @default("unité")
  unitPrice   BigInt
  discountType   DiscountType @default(PERCENT)
  discount       Int          @default(0) // points de base (si PERCENT)
  discountAmount BigInt       @default(0) // centimes (si AMOUNT)
  taxRate        Int          @default(2000)
  netAmount   BigInt   @default(0)
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
}

model Payment {
  id        String        @id @default(cuid())
  companyId String
  invoiceId String
  amount    BigInt
  date      DateTime
  method    PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  notes          String?
  // Clé d'idempotence générée par le client : une même soumission n'est jamais enregistrée deux fois
  idempotencyKey String?       @unique
  // Les paiements ne sont jamais supprimés : ils sont annulés et restent dans l'historique
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?
  createdAt      DateTime      @default(now())
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice        Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([invoiceId])
}

model Activity {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  type       String // ex : invoice.paid, quote.accepted
  entityType String
  entityId   String
  message    String
  amount     BigInt?
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
}


// ─────────────── Modules métier complémentaires ───────────────

enum ProspectStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

model Prospect {
  id                  String         @id @default(cuid())
  companyId           String
  name                String
  contactName         String?
  email               String?
  phone               String?
  source              String?
  status              ProspectStatus @default(NEW)
  value               BigInt         @default(0) // valeur estimée de l'affaire (centimes)
  nextActionDate      DateTime?
  notes               String?
  convertedCustomerId String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  company             Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status])
}

model Supplier {
  id          String     @id @default(cuid())
  companyId   String
  name        String
  contactName String?
  email       String?
  phone       String?
  ice         String?
  taxId       String?
  rc          String?
  address     String?
  city        String?
  paymentDays Int?
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchases   Purchase[]

  @@index([companyId, name])
}

model Purchase {
  id            String            @id @default(cuid())
  companyId     String
  supplierId    String
  reference     String // n° de la facture fournisseur
  issueDate     DateTime
  dueDate       DateTime
  category      String?
  subtotal      BigInt // HT
  taxRate       Int               @default(2000)
  taxTotal      BigInt
  total         BigInt // TTC
  amountPaid    BigInt            @default(0)
  paymentStatus PaymentStatus     @default(UNPAID)
  cancelledAt   DateTime?
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier      Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  payments      PurchasePayment[]

  @@index([companyId, paymentStatus])
  @@index([companyId, dueDate])
}

model PurchasePayment {
  id             String        @id @default(cuid())
  companyId      String
  purchaseId     String
  amount         BigInt
  date           DateTime
  method         PaymentMethod @default(BANK_TRANSFER)
  reference      String?
  notes          String?
  idempotencyKey String?       @unique
  voidedAt       DateTime?
  voidReason     String?
  createdById    String?
  createdAt      DateTime      @default(now())
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchase       Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([purchaseId])
}

enum CashAccount {
  CASH
  BANK
}

enum CashDirection {
  IN
  OUT
}

// Opérations de trésorerie saisies manuellement (frais, apports, retraits, virements internes…)
model CashEntry {
  id          String        @id @default(cuid())
  companyId   String
  account     CashAccount
  direction   CashDirection
  amount      BigInt
  date        DateTime
  label       String
  category    String?
  reference   String?
  createdById String?
  createdAt   DateTime      @default(now())
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, account, date])
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  ON_HOLD
  DONE
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  companyId   String
  customerId  String?
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  startDate   DateTime?
  endDate     DateTime?
  budget      BigInt        @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer    Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  tasks       Task[]

  @@index([companyId, status])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Task {
  id          String       @id @default(cuid())
  companyId   String
  projectId   String?
  customerId  String?
  assigneeId  String?
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project     Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  customer    Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([companyId, dueDate])
}

enum ContractStatus {
  DRAFT
  ACTIVE
  TERMINATED
}

enum BillingFrequency {
  ONE_TIME
  MONTHLY
  QUARTERLY
  YEARLY
}

model Contract {
  id         String           @id @default(cuid())
  companyId  String
  customerId String
  reference  String
  title      String
  status     ContractStatus   @default(DRAFT)
  startDate  DateTime
  endDate    DateTime?
  amount     BigInt           @default(0) // montant HT par période de facturation
  frequency  BillingFrequency @default(YEARLY)
  autoRenew  Boolean          @default(false)
  notes      String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer   Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
}

model Employee {
  id         String    @id @default(cuid())
  companyId  String
  firstName  String
  lastName   String
  email      String?
  phone      String?
  position   String?
  department String?
  hireDate   DateTime?
  salary     BigInt    @default(0) // salaire brut mensuel (centimes)
  cin        String?
  cnss       String?
  active     Boolean   @default(true)
  notes      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, active])
}
