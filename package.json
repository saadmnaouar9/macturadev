{
  "name": "mactura",
  "version": "1.0.0",
  "private": true,
  "description": "Mactura — plateforme de gestion commerciale et CRM pour les entreprises marocaines",
  "scripts": {
    "db:start": "node scripts/db.mjs",
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "demo:schema": "node scripts/gen-demo-schema.mjs",
    "db:studio": "prisma studio",
    "test:integration": "node scripts/test-db.mjs && DATABASE_URL=${TEST_DATABASE_URL:-postgresql://mactura:mactura@localhost:5433/mactura_test?schema=public} node --import ./tests/setup/register.mjs --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:all": "npm test && npm run test:integration",
    "dev:webpack": "next dev",
    "start:prod": "next build && next start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "geist": "^1.9.2",
    "lucide-react": "^1.75.0",
    "maplibre-gl": "^6.19.0",
    "next": "^15.5.29",
    "pglite-prisma-adapter": "^0.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "embedded-postgres": "^17.6.0-beta.15",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "5.9"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@embedded-postgres/darwin-x64@17.6.0-beta.15": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
